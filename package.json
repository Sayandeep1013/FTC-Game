  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "predev": "node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true})}catch(_){}\"",
    "build": "next build",
    "prebuild": "node -e \"try{require('fs').rmSync('.next',{recursive:true,force:true})}catch(_){}\"",
    "start": "next start",
    "lint": "next lint",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
