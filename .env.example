# Copy this to .env.local and fill in all values.
# NEVER commit .env.local to git.

# ── Supabase (JS client) ──────────────────────────────────────────────────────
# From: Supabase Dashboard → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Supabase (DB — only for local scripts, never sent to Vercel) ──────────────
# From: Supabase Dashboard → Project → Settings → Database → Connection string
SUPABASE_DB_HOST=aws-1-ap-south-1.pooler.supabase.com
SUPABASE_DB_USER=postgres.your-project-ref
SUPABASE_DB_PASSWORD=your-db-password

# ── App ───────────────────────────────────────────────────────────────────────
# localhost for dev, your Vercel URL for production
NEXT_PUBLIC_APP_URL=http://localhost:3000
